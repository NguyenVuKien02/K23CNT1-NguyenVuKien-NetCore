@model IEnumerable<NvkLesson09.Models.Publisher>

@{
    ViewData["Title"] = "Danh sách loại sách";
}
<h1 class="text-center">@ViewData["Title"]</h1>
<p>
    <a asp-action="NvkCreate" class="btn btn-primary">Thêm mới</a>
</p>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PublisherId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PublisherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th> Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PublisherId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublisherName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    <a asp-action="NvkEdit" asp-route-Nvkid="@item.PublisherId" class="btn btn-primary">Sửa</a>
                    <a asp-action="NvkDetails" asp-route-Nvkid="@item.PublisherId" class="btn btn-info">Xem</a>
                    <a asp-action="NvkDelete" asp-route-Nvkid="@item.PublisherId" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>

