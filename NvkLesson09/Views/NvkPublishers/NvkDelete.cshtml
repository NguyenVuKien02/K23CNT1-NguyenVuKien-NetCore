@model NvkLesson09.Models.Publisher

@{
    ViewData["Title"] = "Delete";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h1 class="my-2">@ViewData["Title"]</h1>
                <h3>Bạn có chắc chắn muốn xóa không</h3>
            </div>
            <div class="card-body">
                <div class="form-group my-1">
                    <label>ID:</label>
                    @Html.DisplayFor(model => model.PublisherId)
                </div>
                <div class="form-group my-1">
                    <label>Tên nhà xuất bản:</label>
                    @Html.DisplayFor(model => model.PublisherName)
                </div>
                <div class="form-group my-1">
                    <label>Phone:</label>
                    @Html.DisplayFor(model => model.Phone)
                </div>
                <div class="form-group my-1">
                    <label>Địa chỉ:</label>
                    @Html.DisplayFor(model => model.Address)
                </div>
            </div>
            <div class="card-footer">
                <form asp-action="NvkDelete">
                    <input type="hidden" asp-for="PublisherId" />
                    <input type="submit" value="Xóa" class="btn btn-danger" />
                    <a asp-action="NvkIndex2" class="btn btn-primary">Quay lại</a>
                </form>

            </div>
        </div>
    </div>
</div>

