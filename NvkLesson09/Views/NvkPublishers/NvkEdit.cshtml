@model NvkLesson09.Models.Publisher

@{
    ViewData["Title"] = "Sửa thông tin";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="NvkEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="card">
                <div class="card-header">
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <div class="form-group my-1">
                        <label asp-for="PublisherId" class="control-label mb-1"></label>
                        <input asp-for="PublisherId" class="form-control" readonly />
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="PublisherName" class="control-label"></label>
                        <input asp-for="PublisherName" class="form-control" />
                        <span asp-validation-for="PublisherName" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="Phone" class="control-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-group">
                        <input type="submit" value="Lưu" class="btn btn-primary" />
                        <a asp-action="NvkIndex2" class="btn btn-danger">Quay lại</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

