@model NvkLesson09.Models.Category

@{
    ViewData["Title"] = "Thông tin chi tiết";
}

<div class="row">
    <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h1 class="my-2">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <div class="form-group my-1">
                        <label>Mã loại:</label>
                        @Html.DisplayNameFor(model => model.CategoryName)
                    </div>
                    <div class="form-group my-1">
                        <label>Tên loại:</label>
                        @Html.DisplayFor(model => model.CategoryName)
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-group">
                    <a asp-action="NvkEdit" asp-route-Nvkid="@Model?.CategoryId" class="btn btn-primary">Edit</a> 
                    <a asp-action="NvkIndex1" class="btn btn-danger">Quay lại</a>
                    </div>
                </div>
            </div>
    </div>
</div>



