@model IEnumerable<NvkLesson09.Models.Category>

@{
    ViewData["Title"] = "Danh sách loại sách";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<form asp-action="NvkIndex1" method="get" class="mb-3">
    <div class="d-flex flex-row-reverse">
        <input type="text" name="keyword" class="form-control w-25 ms-2" placeholder="Tìm thể loại..." value="@Context.Request.Query["keyword"]" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<p>
    <a asp-action="NvkCreate" class="btn btn-primary">Thêm mới</a>
</p>
<style>
    td, th {
        vertical-align: middle !important;
        text-align: center;
    }
</style>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
			</th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th> Hành động</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                    <a asp-action="NvkEdit" asp-route-Nvkid="@item.CategoryId" class="btn btn-primary">Sửa</a> 
                    <a asp-action="NvkDetails" asp-route-Nvkid="@item.CategoryId" class="btn btn-info">Xem</a> 
                    <a asp-action="NvkDelete" asp-route-Nvkid="@item.CategoryId" class="btn btn-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
